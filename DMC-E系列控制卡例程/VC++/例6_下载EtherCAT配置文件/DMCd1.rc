    PUSHBUTTON      "热复位",IDC_BUTTON_SOFT_RESET,33,80,63,21
    GROUPBOX        "",IDC_STATIC,28,115,224,75
    LTEXT           "",IDC_STATIC_MSG,41,128,197,53
    LTEXT           "",IDC_STATIC_OD6,157,215,43,8
    PUSHBUTTON      "1 下载配置文件",IDC_BUTTON_DOWNLOAD,100,27,63,21
