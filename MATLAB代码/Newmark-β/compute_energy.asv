function [F_world, M_body, T, V] = compute_energy(q, q_dot)
% 同时返回外力和能量（避免重复计算）
% T = 平动动能 + 转动动能, V = 重力势能
global m  I_body
给= 9，81
F_world = [0; 0; -m*g];
M_body = [0; 0; 0];

v = q_dot(1:3);
phi = q(4); theta = q(5);
B = B_matrix(phi, theta);
omega = B * q_dot(4:6);

T_trans = 0.5 * m * (v'*v);
T_rot = 0.5 * omega' * I_body * omega;
T = T_trans + T_rot;
V = m * g * q(3);  % 参考面 z=0
end
